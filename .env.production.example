# Plantilla del .env de PRODUCCIÓN (Hostinger).
#
# El despliegue NO sube ningún .env (el rsync excluye .env.*). En el servidor:
#   1. cp .env.production.example .env
#   2. rellena los valores <...>
#   3. php artisan key:generate
# Ver docs/deploy.md.

APP_NAME="Lista de compras"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<dominio>          # HTTPS obligatorio: el service worker y el
                                   # manifest no funcionan fuera de https, y el
                                   # enlace público de cada lista se deriva de
                                   # APP_URL.

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<bd_hostinger>
DB_USERNAME=<usuario_hostinger>
DB_PASSWORD=<password>

SESSION_DRIVER=cookie              # la tabla sessions se eliminó en el saneamiento
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync              # sin colas ni workers en hosting compartido

CACHE_STORE=database              # sin Redis/Memcached; el rate limiting se apoya aquí
# CACHE_PREFIX=

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
